# =============================================================================
# Backend environment variables
# Copy to .env.local and fill in real values. Do not commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ -> your project -> Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# -----------------------------------------------------------------------------
# Murf (TTS / Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key

# -----------------------------------------------------------------------------
# Deepgram (STT / Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key

# -----------------------------------------------------------------------------
# LLM - use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Optional external exercise provider (Day 5 Phase 7)
# Default is local JSON. Set EXERCISE_SOURCE=api to try HTTP first, then fallback.
# -----------------------------------------------------------------------------
EXERCISE_SOURCE=local
# EXERCISE_API_URL=https://example.com/exercises
# EXERCISE_API_TIMEOUT_SECONDS=2
# EXERCISE_API_MAX_ATTEMPTS=2
# EXERCISE_PROVIDER_COOLDOWN_SECONDS=30
# EXERCISE_CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Optional telephony / outbound calling (Day 6)
# Used for readiness and later outbound call phases. Do not commit real secrets.
# -----------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+10000000000
# LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_your_outbound_trunk_id
OUTBOUND_CALLER_NAME=VoiceForBharat Tutor
DEFAULT_COUNTRY_CODE=+91

# -----------------------------------------------------------------------------
# Optional telephony feature flags (Day 6 bonuses). All default to true.
# -----------------------------------------------------------------------------
# TELEPHONY_ENABLED=true
# OUTBOUND_CALLING_ENABLED=true
# BOOTSTRAP_ENABLED=true
# LEARNING_ENABLED=true
# EVALUATION_ENABLED=true
# METRICS_ENABLED=true
# AUDIT_ENABLED=true
# DIAGNOSTICS_ENABLED=true
