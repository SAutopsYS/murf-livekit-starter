# =============================================================================
# Frontend environment variables
# Copy to .env.local and fill in real values. Do not commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport - must match your backend agent's LiveKit project)
# Get these from https://cloud.livekit.io/ -> your project -> Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# -----------------------------------------------------------------------------
# Agent dispatch (optional)
# Leave blank for automatic dispatch; set to agent name for explicit dispatch.
# See https://docs.livekit.io/agents/server/agent-dispatch
# -----------------------------------------------------------------------------
AGENT_NAME=

# -----------------------------------------------------------------------------
# Optional - LiveKit Cloud Sandbox / custom app config
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
# SANDBOX_ID=

# -----------------------------------------------------------------------------
# Production platform (Phase 11)
# Copy values into .env.local. Do not commit secrets.
# AUTH_REQUIRED=false keeps anonymous voice and open instruments (current demo).
# Set AUTH_REQUIRED=true in production once identity is issued.
# -----------------------------------------------------------------------------
# SALORA_PROFILE=development
# AUTH_REQUIRED=false
# SALORA_AUTH_SECRET=
# AUTH_ACCESS_TTL_SECONDS=900
# AUTH_REFRESH_TTL_SECONDS=1209600
# ALLOWED_ORIGINS=
# RATE_LIMIT_TOKEN_PER_MIN=30
# RATE_LIMIT_API_PER_MIN=120
# FEATURE_ANALYTICS=true
# FEATURE_ENTERPRISE=true
# FEATURE_LEARNING=true
# FEATURE_STUDIO=false
# FEATURE_MARKETPLACE=false
# FEATURE_DEVELOPERS=false
